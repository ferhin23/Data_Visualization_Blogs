labs(
x = "Race",
y = "Proportion of Which Race or Ethnicity Wins an Oscar",
title = "Bechdel Test Pass Rate by Genre"
) +
scale_y_continuous(labels = scales::percent_format()) +
theme_minimal()
race <- Oscars |>
group_by(`Race or Ethnicity`) |>
summarise(prop_nom1 = mean(Oscar_Won, na.rm = TRUE)) |>
arrange(desc(prop_nom1))
race
race <- Oscars |>
filter(!is.na(`Race or Ethnicity`)) |>
group_by(`Race or Ethnicity`) |>
summarise(prop_nom1 = mean(Oscar_Won, na.rm = TRUE)) |>
arrange(desc(prop_nom1))
