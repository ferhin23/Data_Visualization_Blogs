ggplot(aes(x = factor(result_binary), y = mean_rating)) +
geom_point(size = 3) +
geom_errorbar(aes(ymin = mean_rating - 2*se,
ymax = mean_rating + 2*se),
width = 0.2) +
labs(
x = "Bechdel Test Result",
y = "Mean IMDb Rating",
title = "Mean IMDb Rating by Bechdel Result"
) +
scale_x_discrete(labels = c("Fail", "Pass")) +
theme_minimal()
ggplot(bechdel, aes(x = factor(result_binary), y = genre)) +
geom_boxplot() +
labs(
x = "Bechdel Test Result",
y = "Genre",
title = "Genre by Bechdel Test Result"
) +
scale_x_discrete(labels = c("Fail", "Pass")) +
theme_minimal()
library(dplyr)
library(tidyr)
library(ggplot2)
bechdel |>
separate_rows(genre, sep = ", ") |>
group_by(genre) |>
summarise(
prop_pass = mean(result_binary, na.rm = TRUE),
n_movies = n()
) |>
filter(n_movies >= 20) |>
ggplot(aes(x = reorder(genre, prop_pass), y = prop_pass)) +
geom_col() +
coord_flip() +
labs(
x = "Genre",
y = "Proportion Passing Bechdel Test",
title = "Bechdel Test Pass Rate by Genre"
) +
scale_y_continuous(labels = scales::percent_format()) +
theme_minimal()
