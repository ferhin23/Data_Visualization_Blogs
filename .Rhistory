filter(Gender != "Na",
Race_Ethnicity != "Na",
Sexual_orientation != "Na"
)
model <- glm(
Oscar_Won ~ Gender + Race_Ethnicity + Sexual_orientation + Category,
data = Oscars_clean,
family = "binomial"
)
tidy(model)
preds <- ggpredict(model, terms = c("Race_Ethnicity", "Category")) |>
as.data.frame()
ggplot(preds, aes(x = x, y = predicted, color = group)) +
geom_point(size = 3) +
geom_line(linewidth = 1) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high, fill = group),
alpha = .2, color = NA) +
facet_wrap(~group) +
labs(
x = "Race Ethnicity",
y = "Predicted Probability of Winning",
color = "Category",
fill = "Category",
title = "Predicted Probability of Winning an Oscar by Race or Ethnicity and Category"
) +
scale_y_continuous(labels = scales::percent_format()) +
theme_minimal()
sexual_orientation <- Oscars |>
filter(`Sexual orientation` != "NA") |>
group_by(Category, `Sexual orientation`) |>
summarise(prop_so1 = mean(Oscar_Won, na.rm = TRUE), .groups = "drop") |>
arrange(desc(prop_so1))
ggplot(sexual_orientation, aes(x = reorder(`Sexual orientation`, prop_so1),
y = prop_so1,
fill = `Sexual orientation`)) +
geom_col() +
facet_wrap(~Category) +
labs(
x = "Sexual Orientation",
y = "Proportion Who Win an Oscar",
title = "Oscar Win Rate by Sexual Orientation"
) +
scale_y_continuous(labels = scales::percent_format()) +
theme_minimal()
