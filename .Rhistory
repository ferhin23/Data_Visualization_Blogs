pred <- ggpredict(model, terms = "Gender")
library(broom)
library(ggeffects)
model <- glm(Oscar_Won ~ Gender + `Race or Ethnicity` + `Sexual orientation` + Category, data = Oscars, family = binomial)
model |> tidy()
pred <- ggpredict(model, terms = "Gender")
plot(pred) + labs(title = "Predicted Probability of Winning by Gender")
