gender <- Oscars |>
filter(Category == "DIRECTING") |>
group_by(Gender) |>
summarise(prop_gender1 = mean(Oscar_Won, na.rm = TRUE), .groups = "drop") |>
arrange(desc(prop_gender1))
ggplot(gender, aes(x = reorder(Gender, prop_gender1),
y = prop_gender1,
fill = Gender)) +
geom_col(show.legend = FALSE) +
labs(
x = "Gender",
y = "Proportion of Who Wins an Oscar",
title = "Oscar Win Rate by Gender"
) +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
theme_minimal()
